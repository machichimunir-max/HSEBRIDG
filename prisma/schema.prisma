generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum VideoProvider {
  LOCAL
  VDOCIPHER
  BUNNY
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String?
  passwordHash          String
  role                  Role                   @default(STUDENT)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  enrollments           Enrollment[]
  lessonProgress        LessonProgress[]
  quizAttempts          QuizAttempt[]
  attestations          Attestation[]
  passwordResetTokens   PasswordResetToken[]
  videoAccessTokens     VideoAccessToken[]

  @@index([email])
  @@index([role])
}

model Course {
  id                    String                 @id @default(cuid())
  title                 String
  slug                  String                 @unique
  shortDescription      String?
  description           String?
  thumbnail             String?
  category              String?
  level                 String?
  duration              Int?
  price                 Decimal?               @db.Decimal(10, 2)
  isPublished           Boolean                @default(false)
  isFree                Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  modules               Module[]
  enrollments           Enrollment[]
  quiz                  Quiz?
  attestations          Attestation[]

  @@index([isPublished, isFree])
  @@index([slug])
  @@index([category])
}

model Module {
  id                    String                 @id @default(cuid())
  courseId              String
  title                 String
  description           String?
  order                 Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons               Lesson[]

  @@unique([courseId, order])
  @@index([courseId])
}

model Lesson {
  id                    String                 @id @default(cuid())
  moduleId              String
  title                 String
  description           String?
  content               String?
  durationSeconds       Int?
  order                 Int
  status                LessonStatus           @default(DRAFT)
  isPreview             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  module                Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress              LessonProgress[]
  videoMetadata         VideoMetadata?

  @@unique([moduleId, order])
  @@index([moduleId])
  @@index([status])
}

model VideoMetadata {
  id                    String                 @id @default(cuid())
  lessonId              String                 @unique
  videoProvider         VideoProvider          @default(LOCAL)
  providerVideoId       String
  duration              Int?
  thumbnail             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  lesson                Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([videoProvider, providerVideoId])
}

model Enrollment {
  id                    String                 @id @default(cuid())
  userId                String
  courseId              String
  enrolledAt            DateTime               @default(now())
  isActive              Boolean                @default(true)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id                    String                 @id @default(cuid())
  userId                String
  lessonId              String
  isStarted             Boolean                @default(false)
  isCompleted           Boolean                @default(false)
  completionPercent     Int                    @default(0)
  lastWatchedAt         DateTime?
  watchTimeSeconds      Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson                Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, isCompleted])
  @@index([lessonId])
}

model VideoAccessToken {
  id                    String                 @id @default(cuid())
  userId                String
  lessonId              String
  token                 String                 @unique
  expiresAt             DateTime
  createdAt             DateTime               @default(now())

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id                    String                 @id @default(cuid())
  userId                String
  token                 String                 @unique
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime               @default(now())

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// BOUTIQUE EPI/EPC MODELS

enum QuoteStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model ProductCategory {
  id                    String                 @id @default(cuid())
  slug                  String                 @unique
  titleFr               String
  titleAr               String
  descriptionFr         String?
  descriptionAr         String?
  icon                  String?
  image                 String?
  order                 Int                    @default(0)
  isVisible             Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  products              Product[]

  @@index([isVisible, order])
}

model Product {
  id                    String                 @id @default(cuid())
  categoryId            String
  slug                  String                 @unique
  sku                   String?                @unique
  titleFr               String
  titleAr               String
  descriptionFr         String?
  descriptionAr         String?
  shortDescFr           String?
  shortDescAr           String?
  images                String[]               @default([])
  price                 Decimal?               @db.Decimal(10, 2)
  stockStatus           String                 @default("in_stock")
  certifications        String[]               @default([])
  specifications        Json?
  isVisible             Boolean                @default(true)
  isFeatured            Boolean                @default(false)
  order                 Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  category              ProductCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  quoteItems            QuoteRequestItem[]

  @@index([categoryId, isVisible])
  @@index([isFeatured])
}

model QuoteRequest {
  id                    String                 @id @default(cuid())
  fullName              String
  company               String?
  phone                 String
  email                 String
  categoryName          String?
  message               String
  status                QuoteStatus            @default(NEW)
  adminNotes            String?
  submittedAt           DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  items                 QuoteRequestItem[]

  @@index([status, submittedAt])
  @@index([email])
}

model QuoteRequestItem {
  id                    String                 @id @default(cuid())
  quoteRequestId        String
  productId             String?
  productName           String
  quantity              Int?
  notes                 String?

  quoteRequest          QuoteRequest           @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  product               Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteRequestId])
  @@index([productId])
}

// RECRUTEMENT HSE MODELS

enum ContractType {
  INTERIM
  CDD
  CDI
}

enum JobScope {
  NATIONAL
  INTERNATIONAL
}

enum ApplicationStatus {
  NEW
  SHORTLISTED
  INTERVIEW
  PLACED
  REJECTED
}

model JobPosting {
  id                    String                 @id @default(cuid())
  titleFr               String
  titleAr               String
  domain                String
  contractType          ContractType
  scope                 JobScope
  location              String?
  descriptionFr         String?
  descriptionAr         String?
  requirementsFr        String?
  requirementsAr        String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  applications          Application[]

  @@index([isActive, createdAt])
  @@index([domain, contractType])
}

model CandidateProfile {
  id                    String                 @id @default(cuid())
  userId                String?
  fullName              String
  email                 String
  phone                 String
  domain                String
  experience            String?
  certifications        String[]               @default([])
  languages             String[]               @default([])
  availability          String?
  cvUrl                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  applications          Application[]

  @@index([email])
  @@index([domain])
}

model Application {
  id                    String                 @id @default(cuid())
  jobPostingId          String
  candidateProfileId    String
  status                ApplicationStatus      @default(NEW)
  coverLetter           String?
  adminNotes            String?
  appliedAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  jobPosting            JobPosting             @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  candidateProfile      CandidateProfile       @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([status, appliedAt])
  @@index([jobPostingId])
  @@index([candidateProfileId])
}

model EmployerRequest {
  id                    String                 @id @default(cuid())
  companyName           String
  contactName           String
  email                 String
  phone                 String
  domain                String
  contractType          ContractType
  location              String?
  scope                 JobScope
  needs                 String
  status                String                 @default("NEW")
  adminNotes            String?
  submittedAt           DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status, submittedAt])
  @@index([domain])
}

// SITE SETTINGS MODEL

model SiteSetting {
  id                    String                 @id @default(cuid())
  siteName              String                 @default("HSE BRIDGE")
  contactEmail          String?
  contactPhone          String?
  whatsappNumber        String?
  address               String?
  instagramUrl          String?
  linkedinUrl           String?
  updatedAt             DateTime               @updatedAt
}

// QUIZ & ATTESTATION MODELS

model Quiz {
  id                    String                 @id @default(cuid())
  courseId              String                 @unique
  passingScore          Int                    @default(70)
  timeLimit             Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions             QuizQuestion[]
  attempts              QuizAttempt[]

  @@index([courseId])
}

model QuizQuestion {
  id                    String                 @id @default(cuid())
  quizId                String
  question              String
  options               String[]
  correctAnswer         Int
  order                 Int

  quiz                  Quiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id                    String                 @id @default(cuid())
  userId                String
  quizId                String
  score                 Int
  passed                Boolean
  answers               Json
  completedAt           DateTime               @default(now())

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz                  Quiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
  @@index([completedAt])
}

model Attestation {
  id                    String                 @id @default(cuid())
  userId                String
  courseId              String
  certificateNumber     String                 @unique
  issuedAt              DateTime               @default(now())
  pdfUrl                String?

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}
